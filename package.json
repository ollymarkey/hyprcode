{
  "name": "hyprcode",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:server": "bun --cwd apps/server run dev",
    "dev:web": "bun --cwd apps/web run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "fmt": "turbo run fmt",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.9.6",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0"
  }
}
